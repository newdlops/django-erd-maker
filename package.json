{
  "name": "django-erd-maker",
  "displayName": "Django ERD Maker",
  "description": "Explore Django models, fields, and relationships in an interactive entity relationship diagram.",
  "version": "0.0.1073",
  "publisher": "newdlops",
  "private": true,
  "license": "GPL-3.0-only",
  "icon": "media/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/newdlops/django-erd-maker.git"
  },
  "homepage": "https://github.com/newdlops/django-erd-maker#readme",
  "bugs": {
    "url": "https://github.com/newdlops/django-erd-maker/issues"
  },
  "keywords": ["django", "erd", "database", "models", "relationships", "schema"],
  "galleryBanner": {"color": "#081018", "theme": "dark"},
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Django ERD Maker reads local workspace files and runs bundled native analysis and layout tools."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The analyzer requires a local filesystem on the extension host."
    }
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:djangoErd.openDiagram",
    "onCommand:djangoErd.refreshDiagram",
    "onCommand:djangoErd.showLog"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "djangoErd.openDiagram",
        "title": "Django ERD: Open Diagram",
        "category": "Django ERD"
      },
      {
        "command": "djangoErd.refreshDiagram",
        "title": "Django ERD: Refresh Diagram",
        "category": "Django ERD"
      },
      {
        "command": "djangoErd.showLog",
        "title": "Django ERD: Show Logs",
        "category": "Django ERD"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:analyzer",
    "build:analyzer": "cargo build --release --manifest-path analyzer/Cargo.toml",
    "build:extension": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "npm run typecheck",
    "vscode:uninstall": "node ./scripts/vscode-uninstall.mjs",
    "test:phase2": "npm run build && node --test test/integration/phase2-discovery.test.mjs",
    "verify:ogdf-binaries": "node scripts/verify-ogdf-binaries.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "prepare:release": "bash scripts/prepare-release.sh",
    "package:vsix": "bash scripts/package-release.sh",
    "vscode:prepublish": "node scripts/verify-release-artifacts.mjs --package-only",
    "test:e2e": "npm run build && node test/e2e/run-e2e.mjs",
    "test": "npm run typecheck && cargo test --manifest-path analyzer/Cargo.toml",
    "analyzer:run": "cargo run --manifest-path analyzer/Cargo.toml",
    "analyze:codeidx-log": "node scripts/analyze-codeidx-log.mjs log.txt"
  },
  "devDependencies": {
    "onnxruntime-node": "^1.26.0",
    "typescript": "^5.9.3"
  }
}
